OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-4o-mini
# Optional for OpenAI-compatible services:
# OPENAI_BASE_URL=https://api.example.com/v1

# Local application settings (optional):
# HK_DATA_DIR=data
# HK_MODEL_TIMEOUT_SECONDS=120

# Optional standalone V1 Agent kernel tiers (not product generation routing):
# AGENT_HIGH_MODEL defaults to OPENAI_MODEL; no medium/low fallback.
# AGENT_HIGH_MODEL=gpt-4o-mini
# AGENT_MEDIUM_MODEL=gpt-4o-mini
# AGENT_LOW_MODEL=gpt-4o-mini
# AGENT_LOW_MAX_OUTPUT_TOKENS=1024
# AGENT_MODEL_TIMEOUT_SECONDS=120
