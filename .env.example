OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-4o-mini
# Optional for OpenAI-compatible services:
# OPENAI_BASE_URL=https://api.example.com/v1

# Local application settings (optional):
# HK_DATA_DIR=data
# HK_MODEL_TIMEOUT_SECONDS=120

# Evaluation grader: the model must be selected explicitly; never defaults to OPENAI_MODEL.
# Shares OPENAI_API_KEY / OPENAI_BASE_URL unless overridden below.
# HK_EVAL_GRADER_MODEL=gpt-4o-mini
# HK_EVAL_GRADER_API_KEY=replace-with-your-grader-api-key
# HK_EVAL_GRADER_BASE_URL=https://api.example.com/v1

# Course research requires at least one provider. Both keys are optional individually.
# Never send these keys to the browser:
# TAVILY_API_KEY=your-tavily-api-key
# EXA_API_KEY=your-exa-api-key

# Optional standalone V1 Agent kernel tiers (not product generation routing):
# AGENT_HIGH_MODEL defaults to OPENAI_MODEL; no medium/low fallback.
# AGENT_HIGH_MODEL=gpt-4o-mini
# AGENT_MEDIUM_MODEL=gpt-4o-mini
# AGENT_LOW_MODEL=gpt-4o-mini
# AGENT_LOW_MAX_OUTPUT_TOKENS=1024
# AGENT_MODEL_TIMEOUT_SECONDS=120
