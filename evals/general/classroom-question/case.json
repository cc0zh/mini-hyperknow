{
  "schema_version": 2,
  "id": "classroom-question",
  "version": "2",
  "title": "按已确认板书位置提问",
  "tags": [
    "B05",
    "development",
    "uncalibrated"
  ],
  "task": {
    "profile": "question",
    "input": {
      "question": "请解释当前这一步为什么成立，不要提前使用后面的结论。"
    }
  },
  "prerequisites": {
    "resources": {
      "session": {
        "kind": "session"
      }
    }
  },
  "steps": [
    {
      "id": "progress",
      "action": "lesson.progress",
      "input": {
        "session": "session",
        "cursor": "next"
      },
      "when": {
        "state": [
          "preparing",
          "waiting",
          "terminal"
        ],
        "action": "lesson.progress"
      },
      "optional": false,
      "checkpoint": "prefix"
    },
    {
      "id": "question",
      "action": "lesson.question",
      "input": {
        "session": "session",
        "question": "请解释当前这一步为什么成立，不要提前使用后面的结论。",
        "was_playing": false
      },
      "when": {
        "state": [
          "waiting",
          "terminal"
        ],
        "action": "lesson.question"
      },
      "optional": false,
      "checkpoint": "final"
    }
  ],
  "capture": [
    "final",
    "prefix"
  ],
  "checks": [
    {
      "check_id": "saved_output",
      "version": "1",
      "kind": "rule",
      "evaluator": "saved_business_output",
      "criterion": "实际业务结果完成保存，不以工具回执替代最终提交",
      "pass_when": "当前实际保存证据满足要求",
      "fail_when": "当前实际保存证据不满足要求",
      "evidence": [
        "final"
      ],
      "required": true,
      "applicable_when": {},
      "evidence_fields": []
    },
    {
      "check_id": "visible_context",
      "version": "1",
      "kind": "llm",
      "evaluator": "rubric-v1",
      "criterion": "回答回应当前板书疑惑并遵守已确认上下文",
      "pass_when": "依据已确认前缀解释问题，不冒称学习者已学后续",
      "fail_when": "答非所问、依赖未展示内容或错误理解当前位置",
      "evidence": [
        "prefix",
        "final"
      ],
      "required": true,
      "applicable_when": {},
      "evidence_fields": [
        "runs",
        "resources"
      ]
    }
  ],
  "reference_facts": [
    "令u=x²，局部变化率du/dx=2x，sin(u)对u的导数为cos(u)，故sin(x²)的导数为2x·cos(x²)。",
    "参考事实用于核对知识，不要求唯一措辞、特定比喻或固定工具调用顺序。"
  ],
  "limits": {
    "max_actions": 32,
    "max_model_calls": 32,
    "wait_seconds": 420,
    "poll_seconds": 0.25
  },
  "completion": {
    "states": [
      "waiting",
      "terminal"
    ],
    "outcomes": [
      "success"
    ]
  }
}
