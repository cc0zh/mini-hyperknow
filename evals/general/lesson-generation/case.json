{
  "schema_version": 2,
  "id": "lesson-generation",
  "version": "2",
  "title": "固定真实大纲下生成讲义",
  "tags": [
    "B04",
    "development",
    "uncalibrated"
  ],
  "task": {
    "profile": "lesson",
    "input": {}
  },
  "prerequisites": {
    "resources": {
      "session": {
        "kind": "session"
      }
    }
  },
  "steps": [
    {
      "id": "prepare",
      "action": "lesson.prepare",
      "input": {
        "session": "session"
      },
      "when": {
        "state": [
          "preparing",
          "waiting",
          "terminal"
        ],
        "action": "lesson.prepare"
      },
      "optional": false,
      "checkpoint": "final"
    }
  ],
  "capture": [
    "final"
  ],
  "checks": [
    {
      "check_id": "saved_output",
      "version": "1",
      "kind": "rule",
      "evaluator": "saved_business_output",
      "criterion": "实际业务结果完成保存，不以工具回执替代最终提交",
      "pass_when": "当前实际保存证据满足要求",
      "fail_when": "当前实际保存证据不满足要求",
      "evidence": [
        "final"
      ],
      "required": true,
      "applicable_when": {},
      "evidence_fields": []
    },
    {
      "check_id": "lesson_alignment",
      "version": "1",
      "kind": "llm",
      "evaluator": "rubric-v1",
      "criterion": "讲义忠实于固定真实课时大纲，板书与讲解一致",
      "pass_when": "围绕该课时范围，推导准确且板书可对应讲解",
      "fail_when": "偏离大纲、知识错误或板书与讲解冲突",
      "evidence": [
        "final"
      ],
      "required": true,
      "applicable_when": {},
      "evidence_fields": [
        "runs",
        "resources"
      ]
    }
  ],
  "reference_facts": [
    "令u=x²，局部变化率du/dx=2x，sin(u)对u的导数为cos(u)，故sin(x²)的导数为2x·cos(x²)。",
    "参考事实用于核对知识，不要求唯一措辞、特定比喻或固定工具调用顺序。"
  ],
  "limits": {
    "max_actions": 32,
    "max_model_calls": 32,
    "wait_seconds": 420,
    "poll_seconds": 0.25
  },
  "completion": {
    "states": [
      "waiting",
      "terminal"
    ],
    "outcomes": [
      "success"
    ]
  }
}
