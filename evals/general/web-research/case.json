{
  "schema_version": 2,
  "id": "web-research",
  "version": "2",
  "title": "真实网页调研及引用支持",
  "tags": [
    "B02",
    "development",
    "uncalibrated"
  ],
  "task": {
    "profile": "research",
    "input": {
      "goal": "检索并比较两种解释链式法则的公开教学材料，说明各自适合的学习基础，注明实际阅读来源。"
    }
  },
  "prerequisites": {},
  "steps": [
    {
      "id": "research",
      "action": "research.create",
      "input": {
        "goal": "检索并比较两种解释链式法则的公开教学材料，说明各自适合的学习基础，注明实际阅读来源。"
      },
      "when": {
        "state": [
          "preparing",
          "waiting",
          "terminal"
        ],
        "action": "research.create"
      },
      "optional": false,
      "checkpoint": "final"
    }
  ],
  "capture": [
    "final"
  ],
  "checks": [
    {
      "check_id": "saved_output",
      "version": "1",
      "kind": "rule",
      "evaluator": "saved_business_output",
      "criterion": "实际业务结果完成保存，不以工具回执替代最终提交",
      "pass_when": "当前实际保存证据满足要求",
      "fail_when": "当前实际保存证据不满足要求",
      "evidence": [
        "final"
      ],
      "required": true,
      "applicable_when": {},
      "evidence_fields": []
    },
    {
      "check_id": "source_support",
      "version": "1",
      "kind": "llm",
      "evaluator": "rubric-v1",
      "criterion": "报告结论由本次已读来源支持",
      "pass_when": "引用能对应实际已读正文，比较不超出来源",
      "fail_when": "伪造来源、未读即引或正文不支持结论",
      "evidence": [
        "final"
      ],
      "required": true,
      "applicable_when": {},
      "evidence_fields": [
        "runs",
        "resources"
      ]
    }
  ],
  "reference_facts": [
    "令u=x²，局部变化率du/dx=2x，sin(u)对u的导数为cos(u)，故sin(x²)的导数为2x·cos(x²)。",
    "参考事实用于核对知识，不要求唯一措辞、特定比喻或固定工具调用顺序。"
  ],
  "limits": {
    "max_actions": 32,
    "max_model_calls": 32,
    "wait_seconds": 420,
    "poll_seconds": 0.25
  },
  "completion": {
    "states": [
      "waiting",
      "terminal"
    ],
    "outcomes": [
      "success"
    ]
  }
