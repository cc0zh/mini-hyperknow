    {
      "id": "create",
      "action": "conversation.create",
      "input": {},
      "when": {
        "state": [
          "preparing",
          "waiting",
          "terminal"
        ],
        "action": "conversation.create"
      },
      "optional": false,
      "checkpoint": "create"
    },
    {
      "id": "intuition",
      "action": "assistance.message",
      "input": {
        "text": "请分两步讲链式法则：本轮只讲直觉并保存两步计划，等我明确继续后再计算sin(x²)的导数。"
      },
      "when": {
        "state": [
          "waiting",
          "terminal"
        ],
        "action": "assistance.message"
      },
      "optional": false,
      "checkpoint": "first"
    },
    {
      "id": "continue",
      "action": "assistance.continue",
      "input": {},
      "when": {
        "state": [
          "waiting",
          "terminal"
        ],
        "action": "assistance.continue"
      },
      "optional": false,
      "checkpoint": "final"
    }
  ],
  "capture": [
