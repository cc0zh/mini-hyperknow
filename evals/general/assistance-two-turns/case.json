      "fail_when": "当前实际保存证据不满足要求",
      "evidence": [
        "first",
        "final"
      ],
      "required": true,
      "applicable_when": {},
      "evidence_fields": []
    },
    {
      "check_id": "mathematics",
      "version": "1",
      "kind": "llm",
      "evaluator": "rubric-v1",
      "criterion": "链式求导相关陈述准确",
      "pass_when": "如涉及sin(x²)求导，内外层关系及2x来源正确",
      "fail_when": "公式、局部变化关系或解释出现数学错误",
      "evidence": [
        "final"
      ],
      "required": true,
      "applicable_when": {},
      "evidence_fields": [
        "turns",
        "artifacts"
      ]
    },
    {
      "check_id": "continuity",
      "version": "1",
      "kind": "llm",
      "evaluator": "rubric-v1",
