      "checkpoint": "create"
    },
    {
      "id": "generate",
      "action": "assistance.message",
      "input": {
        "text": "请生成一个quiz教学产物，帮助我理解sin(x²)求导为什么乘2x，准确解释内外层局部变化关系。"
      },
      "when": {
        "state": [
          "waiting",
          "terminal"
