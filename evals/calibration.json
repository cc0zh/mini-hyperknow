      "id": "correct-and-responsive",
      "case": {
        "schema_version": 3,
        "id": "control-chain-rule",
        "revision": 1,
        "title": "独立评分控制：链式法则",
        "domain": "mathematics",
        "workflow": "assistance",
        "learner": {
          "background": "会幂函数求导，但尚不理解复合函数。",
          "goal": "理解内层变化率为何必须相乘。",
          "misconceptions": [
            "把复合函数直接当作单个变量求导，漏乘内层变化率。"
          ]
        },
        "task": {
          "mode": "scripted",
          "max_turns": 2,
          "clarification": "skip",
          "opening": "我会求 x² 的导数。对 y=(3x+1)²，我写成 y′=2(3x+1)，为什么有人说少了东西？不要只背公式。",
          "follow_ups": [
            "里面虽然有3，但整体不是已经平方求导了吗？能用变化快慢解释为什么还乘3吗？"
          ]
        },
        "budget": {
          "timeout_seconds": 600,
          "max_actions": 100,
          "max_observed_calls": 80
        },
        "rubric": [
          {
            "id": "derivatives",
            "dimension": "correctness",
            "description": "对公开任务中的y=(3x+1)²，导数应为6(3x+1)，不得漏掉内层变化率3；只评实际出现的算式，不要求回答未提问的函数。",
            "critical": true
          },
          {
            "id": "rate-explanation",
            "dimension": "pedagogy",
            "description": "将乘法与复合变化率联系起来，区分内外层，而非只重复公式或无关比喻。",
            "critical": true
          },
          {
            "id": "respond-and-transfer",
            "dimension": "adaptation",
            "description": "第二轮直接回应“已经平方为何仍乘3”的真实困惑，而非只重复答案或同意错误理解。",
            "critical": true
          }
        ],
        "reference": {
          "facts": [
            "复合函数 f(g(x)) 的导数为 f′(g(x))g′(x)。",
            "(3x+1)² 的导数为 6(3x+1)。",
            "(x²+1)³ 的导数为 6x(x²+1)²。"
          ],
          "sources": [
            {
              "title": "OpenStax Calculus Volume 1",
              "url": "https://openstax.org/books/calculus-volume-1/pages/3-6-the-chain-rule",
              "locator": "3.6 The Chain Rule"
            }
          ],
          "review_status": "author_reviewed",
          "reviewer": "repository-assistant; independent human review pending"
        },
        "provenance": "Synthetic authored evaluator control, not a recorded product run or a human learning observation."
      },
      "turns": [
        {
          "role": "student",
          "text": "我会求 x² 的导数。对 y=(3x+1)²，我写成 y′=2(3x+1)，为什么有人说少了东西？不要只背公式。"
        },
        {
          "role": "tutor",
          "text": "令u=3x+1，y=u²。先对u求导得到2u，再乘上u随x变化的速度3，所以y′=6(3x+1)。"
        },
        {
          "role": "student",
          "text": "里面虽然有3，但整体不是已经平方求导了吗？能用变化快慢解释为什么还乘3吗？"
        },
        {
          "role": "tutor",
          "text": "你困惑的是平方求导是否已经算了里面的变化。2u只是每单位u变化引起的y变化，而x每增加很小一份，u增加3份，所以还要乘3。这里内层是3x+1，外层是平方。"
        }
      ],
      "expected": {
        "derivatives": "met",
        "rate-explanation": "met",
        "respond-and-transfer": "met"
      }
    },
